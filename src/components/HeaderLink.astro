---
import type { HTMLAttributes } from 'astro/types';
import ShortcutKey from './ShortcutKey.astro';

type Props = HTMLAttributes<'a'> & { shortcut?: string };

const { href, class: className, shortcut, ...props } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = '/' + Astro.url.pathname.slice(base.length).replace(/^\/+/, '');
const localHref = '/' + (base && href?.startsWith(base + '/') ? href.slice(base.length) : (href ?? '/')).replace(/^\/+/, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = localHref === pathname || localHref === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} data-navigation-shortcut={shortcut} {...props}>
	{shortcut ? <ShortcutKey shortcuts={[shortcut]} active={isActive}><slot /></ShortcutKey> : <slot />}
</a>
<style>
	a {
		color: var(--muted);
		text-decoration: none;
		text-decoration-thickness: 2px;
	}
	a.active {
		color: var(--accent);
		font-weight: 700;
	}
</style>
