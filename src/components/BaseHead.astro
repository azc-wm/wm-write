---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import KeyboardController from './KeyboardController.astro';
import { canIndex, site } from '../site.config';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	article?: boolean;
	pubDate?: Date;
	updatedDate?: Date;
	indexable?: boolean;
}

const { title, description, image, article = false, pubDate, updatedDate, indexable = canIndex } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(typeof image === 'string' ? image : image?.src ?? site.seo.socialImage, site.url);
const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href={new URL('/sitemap-index.xml', site.url)} />
<link rel="alternate" type="application/rss+xml" title={site.title} href={new URL('/rss.xml', site.url)} />
<meta name="generator" content={Astro.generator} />

<script define:vars={{ defaultTheme: site.theme.default }}>
	const root = document.documentElement;
	const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
	let preference = null;
	try { preference = localStorage.getItem('theme'); } catch {}
	const hasPreference = preference === 'light' || preference === 'dark';
	const resolveTheme = (saved, systemIsDark) => {
		if (saved === 'light' || saved === 'dark') return saved;
		if (defaultTheme === 'light' || defaultTheme === 'dark') return defaultTheme;
		return systemIsDark ? 'dark' : 'light';
	};
	root.dataset.theme = resolveTheme(preference, systemTheme.matches);
	if (defaultTheme === 'system' && !hasPreference) {
		systemTheme.addEventListener('change', (event) => {
			try {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') return;
			} catch {}
			root.dataset.theme = resolveTheme(null, event.matches);
		});
	}
	try {
		const width = Number(localStorage.getItem('content-width'));
		if (width >= 50 && width <= 100) root.style.setProperty('--content-width', `${width}ch`);
	} catch {}
</script>

<link rel="canonical" href={canonicalURL} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
{article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<KeyboardController />
