---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings?: Heading[] };

const { headings = [] } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{items.length > 0 && <nav class="article-toc aside-section" aria-label="On this page">
	<details open>
		<summary>On this page</summary>
		<ol>
			{items.map((heading) => <li class:list={{ 'toc-h3': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
		</ol>
	</details>
</nav>}

<style>
	.article-toc { max-width: 220px; margin-top: 4rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .8rem; }
	.article-toc:first-child { margin-top: 0; }
	.article-toc summary { margin: 0 0 var(--space-3); color: var(--text); font-size: .7rem; font-weight: normal; letter-spacing: .08em; text-transform: uppercase; list-style: none; }
	.article-toc summary::-webkit-details-marker { display: none; }
	.article-toc summary::marker { display: none; }
	.article-toc ol { margin: 0; padding: 0; list-style: none; }
	.article-toc li { margin: .4rem 0; }
	.article-toc .toc-h3 { padding-left: 1rem; }
	.article-toc a { color: var(--accent); text-underline-offset: .15em; }
	.article-toc a:hover, .article-toc a:focus-visible { color: var(--text); }

	@media (max-width: 1099px) {
		.article-toc { max-width: none; margin-top: var(--space-8); padding: .7rem var(--space-4); border: 1px solid var(--line); background: var(--background); }
		.article-toc summary { cursor: pointer; }
		.article-toc ol { padding-top: .75rem; }
	}
</style>
