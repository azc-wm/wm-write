---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Prose from '../components/Prose.astro';
import { site } from '../site.config';
import { Content as Welcome } from '../content/welcome.mdx';

const latestPosts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang={site.language}>
	<head>
		<BaseHead title={site.title} description={site.description} />
	</head>
	<body data-page="static">
		<Header />
		<main>
			<div class="page-content">
			<div class="welcome">
				<Prose><Welcome /></Prose>
			</div>
			<section class="latest" aria-labelledby="latest-title">
				<h2 id="latest-title">Latest posts</h2>
				{latestPosts.length === 0 ? <p class="empty-state">Writing is temporarily empty. Check back soon.</p> : <ol class="latest-grid">
					{latestPosts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`}><h3>{post.data.title}</h3></a>
						</li>
					))}
				</ol>}
			</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.welcome { max-width: none; }
	:global(.welcome-spoken) { max-width: none; padding-left: 1.25rem; border-left: 2px solid var(--accent); }
	:global(.welcome-spoken h1) { margin-top: 0; }
	.latest { margin-top: 5rem; }
	.latest h2 { margin: 0 0 var(--space-4); font-size: var(--font-size-sm); font-weight: normal; letter-spacing: .08em; text-transform: uppercase; }
	.latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
	.post-card { border: 1px solid var(--line); }
	.post-card a { display: block; height: 100%; padding: var(--space-4); color: inherit; text-decoration: none; }
	.post-card h3 { margin: 0; font-size: var(--font-size-md); font-weight: normal; }
	.post-card a:hover h3, .post-card a:focus-visible h3 { color: var(--accent); }
	@media (max-width: 700px) { .latest-grid { grid-template-columns: 1fr; } }
</style>
