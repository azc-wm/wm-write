---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../site.config';
---

<!doctype html>
<html lang={site.language}>
	<head>
		<BaseHead title="Page not found" description="The requested page could not be found." indexable={false} />
	</head>
	<body data-page="static">
		<Header />
		<main>
			<div class="page-content">
				<section aria-labelledby="not-found-title">
					<p class="eyebrow">404</p>
					<h1 id="not-found-title">This page is not here.</h1>
					<p><a href="/">Return home</a></p>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.eyebrow { margin: 0; color: var(--accent); font-size: var(--font-size-sm); letter-spacing: .08em; }
	h1 { max-width: 12ch; margin: .75rem 0 1.5rem; font-weight: normal; }
</style>
