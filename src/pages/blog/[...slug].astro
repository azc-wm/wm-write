---
import { isVisiblePost } from '../../lib/content/visibility';import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import Prose from '../../components/Prose.astro';
import { getArticleBundle } from '../../lib/content/article-bundle-astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => isVisiblePost(data));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const { heroImage, socialImage: ogImage, LeftAside, RightAside } = getArticleBundle(post);
---

<BlogPost {...post.data} heroImage={heroImage} ogImage={ogImage} headings={headings}>
	{LeftAside && <LeftAside slot="left-aside" />}
	<Prose><Content /></Prose>
	{RightAside && <RightAside slot="aside" />}
</BlogPost>
