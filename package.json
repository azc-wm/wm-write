{
  "name": "astro-editorial-blog-starter",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "An opinionated, keyboard-friendly Astro starter for technical writing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azc-wm/wm-write.git"
  },
  "bugs": "https://github.com/azc-wm/wm-write/issues",
  "homepage": "https://github.com/azc-wm/wm-write#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/validate-article-bundles.js && astro dev --background",
    "build": "node scripts/validate-article-bundles.js && astro build",
    "preview": "astro preview",
    "check": "node scripts/validate-article-bundles.js && astro check",
    "doctor": "node scripts/validate-article-bundles.js",
    "test": "node --test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/commit-mono": "^5.3.0",
    "astro": "^7.3.6",
    "katex": "^0.18.9",
    "mermaid": "^12.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.148.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5"
    }
  }
